{
  "name": "@astrid-runtime/sdk",
  "version": "0.2.0",
  "description": "System SDK for building user-space capsules for Astrid OS in JavaScript and TypeScript.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrid-runtime/sdk-js.git",
    "directory": "packages/astrid-sdk"
  },
  "homepage": "https://github.com/astrid-runtime/sdk-js/tree/main/packages/astrid-sdk#readme",
  "bugs": {
    "url": "https://github.com/astrid-runtime/sdk-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    }
  },
  "files": [
    "dist",
    "src",
    "wit-contracts",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "prebuild": "node scripts/generate-contracts.mjs",
    "build": "tsc -b",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "clean": "rm -rf dist src/contracts.ts"
  },
  "devDependencies": {
    "@astrid-runtime/build": "*",
    "esbuild": "^0.25.12"
  },
  "engines": {
    "node": ">=20"
  }
}
